# Exclude all docs by default; only allow explicitly public ones
docs/**
!docs/UNINSTALL.md
!docs/mcp-configs/
!docs/mcp-configs/**

# Benchmark data (may contain window titles and PII)
packages/screen/benchmark_results/
CHANGELOG_INTERNAL.md
.internal/

# Pipeline run outputs (per-episode working directory).
# These are large binary outputs from real recording sessions and personal
# audio content — must never reach a public AGPL repo. Added 2026-05-04
# after the 0788a53 incident where auto-backup committed 5+ GB of WAVs.
working/
contextpulse_pipeline/examples/ep-*/

# Internal handoff / resumption docs. Added 2026-08-17: an auto-backup commit
# (ab50edc, 2026-04-27) put HANDOFF_PHASE3_AMI_BAKE_2026-04-27.md at repo root,
# and it references ~/Projects/CryptoTrader/ — a different private venture — in
# a PUBLIC repo. Size guards can't see a 13 KB text file and gitleaks hunts
# secrets, not other projects' names, so nothing caught it.
HANDOFF_*.md
RESUMPTION_*.md

# NOTE (2026-08-17): the rule above only ignores contextpulse_pipeline/examples/,
# NOT the package. 64 files under contextpulse_pipeline/ are currently TRACKED —
# they were first committed 2026-04-26, eight days BEFORE the 2026-05-04 rule
# was added, and .gitignore never untracks what is already tracked. Adding a
# broader pattern here would be theatre. Untracking is a content decision (where
# should that pipeline live?), tracked as an open action rather than done silently.

# Voice profile / fingerprint artifacts (use S3, not git)
*.npz
fingerprint_result.json
unified_transcript_labeled.json

# Audio / video originals — global catch-all (defense in depth).
# Originals belong in S3 or LFS, never git. The pre-publish gate
# (AgentConfig/scripts/pre-publish.py check 72) will BLOCK any tracked
# file >25 MB, but this keeps them out of the index in the first place.
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.opus
*.mov
*.mp4
*.aac

# Generic personal-research data directories — never meant for git
local-archive/
recordings/
